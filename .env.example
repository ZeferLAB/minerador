# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA coloque os valores reais no código nem no GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Google AI Studio > Get API key
GEMINI_API_KEY=

# Google Cloud Console > APIs & Services > Credentials (com a YouTube Data API v3 ativada)
YOUTUBE_API_KEY=

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha para entrar no site (escolha uma senha forte)
APP_SENHA=

# Texto aleatório e longo (mínimo 32 caracteres). Serve para assinar o login.
SESSAO_SEGREDO=

# Texto aleatório. A Vercel usa para provar que é ela chamando a rodada automática.
CRON_SECRET=
